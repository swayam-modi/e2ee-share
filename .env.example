# =============================================================================
# e2ee-share — environment variable reference
# Copy this file to .env.local for local development.
# Never commit .env.local — it is already in .gitignore.
# =============================================================================


# ─── Server binding ──────────────────────────────────────────────────────────
# The host and port the Node server listens on.
# Default: 0.0.0.0:3001
HOSTNAME= your-host
PORT= port-you-want


# ─── WebSocket URL (client-side) ─────────────────────────────────────────────
# The WebSocket URL the browser connects to for signaling.
# Must be prefixed with NEXT_PUBLIC_ so it is bundled into the client build.
#
# Leave unset in production when Caddy/nginx proxies /ws on the same origin —
# the client will auto-derive wss://<host>/ws from window.location.
#
# Set this explicitly when the signaling server runs on a different
# host/port than the Next.js frontend (e.g. local dev on port 3001):
NEXT_PUBLIC_WS_URL=


# ─── Room settings ───────────────────────────────────────────────────────────
# Maximum number of rooms held in memory at any time.
# Prevents unbounded memory growth. Default: 10000
MAX_ROOMS=10000

# How long (in seconds) a room lives before it is swept.
# Default: 3600 (1 hour)
ROOM_TTL_MAX_SEC=3600


# ─── STUN/TURN servers ───────────────────────────────────────────────────────
# Comma-separated list of STUN URLs.
# Default: Google's public STUN (fine for testing; use your own in production)
STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated list of TURN URLs.
# Leave blank to disable TURN (WebRTC will only use STUN / host candidates).
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=

# TURN shared secret for time-limited credential generation (RFC 8489).
# Required when TURN_URLS is set.  Must be at least 32 random characters.
# Generate with: openssl rand -hex 32
TURN_SECRET=


# ─── Dev-only: allowed HMR origins ───────────────────────────────────────────
# Comma-separated list of origins allowed to connect to the Next.js dev server
# (used for HMR when opening the app on another device on the same LAN).
# Only relevant in development. Do NOT set this in production.
# Example: ALLOWED_DEV_ORIGINS=192.168.1.42,192.168.1.55
ALLOWED_DEV_ORIGINS=


# ─── Proxy trust (security) ──────────────────────────────────────────────────
# Set to "true" ONLY when a trusted reverse proxy (Caddy, nginx, etc.) sits
# in front of this app and sets the X-Forwarded-For header.
# When false (default), the rate limiter uses the raw socket IP from
# X-Real-IP, which server.ts populates directly from req.socket.remoteAddress.
# Setting this to true without a real proxy allows IP spoofing.
TRUST_PROXY=false
